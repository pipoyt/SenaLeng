# Copia este archivo como ".env" (en la carpeta api) y cambia los valores.
PORT=3000
HOST=0.0.0.0

# Clave para firmar las sesiones (JWT). Usa una frase larga y secreta.
JWT_SECRET=cambia-esta-frase-por-una-larga-y-secreta
JWT_EXPIRES_IN=7d

# Superusuario principal: ÚNICA cuenta que ve las estadísticas.
# Solo el dueño del proyecto debe conocer estos datos.
# Si la base de datos ya existe, aplica cambios con:  npm run principal
PRINCIPAL_NOMBRE=Jesus Antonio
PRINCIPAL_CORREO=principal@senaleng.app
PRINCIPAL_PASSWORD=CambiaEstaClave2026

# Crear cuentas de ejemplo (super/admin/usuario) al generar la base de datos
SEED_DEMO_USERS=true

# Videos: tamaño máximo en MB
MAX_VIDEO_MB=60
# Opcional: subir los videos a Cloudinary (nube). Copia el "API environment variable"
# de tu panel de Cloudinary. Si se deja vacío, se guardan en api/uploads.
CLOUDINARY_URL=
